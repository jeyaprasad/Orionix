OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Note: Orionix's reasoning layer runs specifically on OpenAI's open-weight GPT-OSS model (not a generic swappable LLM).
# Default: "openai/gpt-oss-20b" (fast, free-tier friendly on OpenRouter, good for live demos).
# Fallback: "openai/gpt-oss-120b" (for higher-quality offline report generation).
MODEL_NAME=openai/gpt-oss-20b
LOG_LEVEL=INFO

REPORT_MODEL=anthropic/claude-3.5-sonnet:beta
